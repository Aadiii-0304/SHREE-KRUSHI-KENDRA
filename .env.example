# ==============================================================================
# Shree Krushi Kendra - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your credentials.
# NEVER commit your actual .env file or production secret keys to version control.

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Accessible in browser)
# ------------------------------------------------------------------------------
# Razorpay Public Key ID (Required for Razorpay Standard Checkout in browser)
# For Test Mode: starts with "rzp_test_..."
# For Live Mode: starts with "rzp_live_..."
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

# Supabase Project URL & Anon Key (Frontend public client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# ------------------------------------------------------------------------------
# 2. BACKEND / SUPABASE EDGE FUNCTION SECRETS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# WARNING: NEVER expose these secret keys in frontend code or client bundles!

# Razorpay Key ID & Key Secret (Used in Edge Functions for creating & verifying orders)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# Razorpay Webhook Secret (Used to cryptographically verify Razorpay webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# Supabase Service Role Key (Server-side database operations)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
